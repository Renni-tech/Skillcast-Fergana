# SkillCast Fergana — local development settings for `pnpm dev`.
# Copy this file to `.env` (git-ignored) only if you need to change something.
# Every value is optional; the defaults below are used when a value is absent.
# Never put real secrets in .env.example.

# Port for the Fergana frontend (Vite). Open http://localhost:5173/
WEB_PORT=5173

# Port for the API server. The frontend proxies /api requests to it.
API_PORT=8080

# Where both servers listen. 127.0.0.1 (default) keeps the app on this computer
# and avoids a Windows Firewall prompt. Set 0.0.0.0 to open the app from a phone
# or tablet on the same Wi-Fi (pnpm dev then prints the addresses to use).
HOST=127.0.0.1

# API log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# ── Optional services (leave commented out to use the built-in fallbacks) ──
# RunPod model for CV extraction and narrated explanations. Without these the
# app uses its deterministic in-browser extractor and template narration.
# RUNPOD_API_KEY=your-runpod-api-key
# RUNPOD_ENDPOINT_ID=your-runpod-endpoint-id

# Protects GET /api/signals/cron (scheduled refresh of the original SkillCast
# feed). Not needed for local development.
# CRON_SECRET=choose-a-long-random-string

# Not needed: the API stores signal snapshots in a local SQLite file
# (artifacts/api-server/db/skillcast.db) using Node's built-in SQLite. It is
# created automatically by `pnpm dev`; nothing is generated or downloaded.
# DATABASE_URL is only used by the unused PostgreSQL helper in lib/db.
